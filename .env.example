# 新安装通过网页注册，填写相同账本号的两人绑定同一本日历。
PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# 服务器QQ发件邮箱。授权码在QQ邮箱设置中开启SMTP后获取，不是QQ登录密码。
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
# 旧版本账号自动保留，无须再设置 USER1/USER2。
# 数据库默认自动加密，密钥保存在 DATA_DIR/.database-key，务必备份并保密。
# 可选：用外部管理的 64 位十六进制随机密钥替代密钥文件。
# 已有加密数据后不可随意修改或清空此配置，否则无法解密。
# DB_ENCRYPTION_KEY=

# 可选：私密备忘 AI 整理，使用兼容 Chat Completions 的服务。
# BASE_URL 为接口根地址（通常包含 /v1），不要填写 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

