[
  {
    "id": 1,
    "category": "past",
    "text": "旧时光被轻轻敲了敲门。"
  },
  {
    "id": 2,
    "category": "past",
    "text": "那一页，又让心软了一下。"
  },
  {
    "id": 3,
    "category": "past",
    "text": "迟到的情话正在补交。"
  },
  {
    "id": 4,
    "category": "past",
    "text": "从前的风，吹到指尖了。"
  },
  {
    "id": 5,
    "category": "past",
    "text": "记忆偷偷亮起了一盏灯。"
  },
  {
    "id": 6,
    "category": "past",
    "text": "那天的心跳，还没写完。"
  },
  {
    "id": 7,
    "category": "past",
    "text": "泛黄之前，再偏爱一遍。"
  },
  {
    "id": 8,
    "category": "past",
    "text": "故事回头看了你一眼。"
  },
  {
    "id": 9,
    "category": "past",
    "text": "余温正从字缝里冒出来。"
  },
  {
    "id": 10,
    "category": "past",
    "text": "那次相见，值得慢慢讲。"
  },
  {
    "id": 11,
    "category": "past",
    "text": "原来旧日期也会脸红。"
  },
  {
    "id": 12,
    "category": "past",
    "text": "一段笑声正在被找回来。"
  },
  {
    "id": 13,
    "category": "past",
    "text": "被省略的甜，补上了。"
  },
  {
    "id": 14,
    "category": "past",
    "text": "回忆里还有半句舍不得。"
  },
  {
    "id": 15,
    "category": "past",
    "text": "时间走远，细节留下。"
  },
  {
    "id": 16,
    "category": "past",
    "text": "那场晚风，又有了下文。"
  },
  {
    "id": 17,
    "category": "past",
    "text": "旧照片旁，添了点心事。"
  },
  {
    "id": 18,
    "category": "past",
    "text": "当时的嘴硬，现在补个注。"
  },
  {
    "id": 19,
    "category": "past",
    "text": "靠近过的瞬间，没被忘记。"
  },
  {
    "id": 20,
    "category": "past",
    "text": "翻到这里，连标点都温柔。"
  },
  {
    "id": 21,
    "category": "past",
    "text": "往事正在轻声叫你的名字。"
  },
  {
    "id": 22,
    "category": "past",
    "text": "那天没牵住的话，写下来。"
  },
  {
    "id": 23,
    "category": "past",
    "text": "一颗旧糖，重新拆了包装。"
  },
  {
    "id": 24,
    "category": "past",
    "text": "回程太短，回味却很长。"
  },
  {
    "id": 25,
    "category": "past",
    "text": "有些眼神，后来才读懂。"
  },
  {
    "id": 26,
    "category": "past",
    "text": "心动的起点正在被圈出。"
  },
  {
    "id": 27,
    "category": "past",
    "text": "那次偶然，越想越可爱。"
  },
  {
    "id": 28,
    "category": "past",
    "text": "从前藏着的笑意露出来了。"
  },
  {
    "id": 29,
    "category": "past",
    "text": "褪色的是日期，不是偏爱。"
  },
  {
    "id": 30,
    "category": "past",
    "text": "再认领一次那天的小幸福。"
  },
  {
    "id": 31,
    "category": "past",
    "text": "旧梦翻身，碰到了你。"
  },
  {
    "id": 32,
    "category": "past",
    "text": "这次，给当时的心情署名。"
  },
  {
    "id": 33,
    "category": "past",
    "text": "记忆的拼图又找到一块。"
  },
  {
    "id": 34,
    "category": "past",
    "text": "那阵傻笑，现在有了解释。"
  },
  {
    "id": 35,
    "category": "past",
    "text": "原来伏笔早就写在那天。"
  },
  {
    "id": 36,
    "category": "past",
    "text": "重读一次，还是想靠近。"
  },
  {
    "id": 37,
    "category": "past",
    "text": "岁月漏记的，心帮忙补上。"
  },
  {
    "id": 38,
    "category": "past",
    "text": "那顿饭的甜，不只在菜里。"
  },
  {
    "id": 39,
    "category": "past",
    "text": "曾经的普通，后来很珍贵。"
  },
  {
    "id": 40,
    "category": "past",
    "text": "把当年的小鹿叫回来看看。"
  },
  {
    "id": 41,
    "category": "past",
    "text": "那天的月色，有了旁白。"
  },
  {
    "id": 42,
    "category": "past",
    "text": "错过的句号，换成了逗号。"
  },
  {
    "id": 43,
    "category": "past",
    "text": "回忆正在悄悄加一勺糖。"
  },
  {
    "id": 44,
    "category": "past",
    "text": "没说出口的谢意，找到了家。"
  },
  {
    "id": 45,
    "category": "past",
    "text": "旧票根里夹着一句想念。"
  },
  {
    "id": 46,
    "category": "past",
    "text": "走散在记忆里的细节归队了。"
  },
  {
    "id": 47,
    "category": "past",
    "text": "那次等候，如今也暖暖的。"
  },
  {
    "id": 48,
    "category": "past",
    "text": "一声晚安，被留到了现在。"
  },
  {
    "id": 49,
    "category": "past",
    "text": "重新路过那段并肩的路。"
  },
  {
    "id": 50,
    "category": "past",
    "text": "当时没察觉的温柔，被标亮了。"
  },
  {
    "id": 51,
    "category": "past",
    "text": "熟悉的日期，陌生的新心事。"
  },
  {
    "id": 52,
    "category": "past",
    "text": "那次心照不宣，终于有了字。"
  },
  {
    "id": 53,
    "category": "past",
    "text": "回头一看，满眼都是小事。"
  },
  {
    "id": 54,
    "category": "past",
    "text": "原来舍不得删的是那天的你。"
  },
  {
    "id": 55,
    "category": "past",
    "text": "记忆没有快进，只有慢放。"
  },
  {
    "id": 56,
    "category": "past",
    "text": "把从前的局促写成可爱。"
  },
  {
    "id": 57,
    "category": "past",
    "text": "这页旧账，记的全是心动。"
  },
  {
    "id": 58,
    "category": "past",
    "text": "那段对白，还能让人偷笑。"
  },
  {
    "id": 59,
    "category": "past",
    "text": "远去的笑脸，在字里清晰了。"
  },
  {
    "id": 60,
    "category": "past",
    "text": "当年的笨拙，值得被轻轻抱住。"
  },
  {
    "id": 61,
    "category": "past",
    "text": "一小段从前正在重新发光。"
  },
  {
    "id": 62,
    "category": "past",
    "text": "那天的好天气，又被提起。"
  },
  {
    "id": 63,
    "category": "past",
    "text": "留白处，长出了一句喜欢。"
  },
  {
    "id": 64,
    "category": "past",
    "text": "旧日的拥抱有了文字版。"
  },
  {
    "id": 65,
    "category": "past",
    "text": "想起那时，心就走慢半拍。"
  },
  {
    "id": 66,
    "category": "past",
    "text": "那句玩笑，藏了多少认真。"
  },
  {
    "id": 67,
    "category": "past",
    "text": "回忆不是倒带，是舍不得。"
  },
  {
    "id": 68,
    "category": "past",
    "text": "把没写完的约会续上落款。"
  },
  {
    "id": 69,
    "category": "past",
    "text": "从前的慌张，今天看很甜。"
  },
  {
    "id": 70,
    "category": "past",
    "text": "那次转身，原来还有故事。"
  },
  {
    "id": 71,
    "category": "past",
    "text": "一枚旧日期被认真擦亮。"
  },
  {
    "id": 72,
    "category": "past",
    "text": "当时的心事正在解除静音。"
  },
  {
    "id": 73,
    "category": "past",
    "text": "那场雨，终于有了晴天注脚。"
  },
  {
    "id": 74,
    "category": "past",
    "text": "回忆的角落藏着新发现。"
  },
  {
    "id": 75,
    "category": "past",
    "text": "再替那天的自己说句话。"
  },
  {
    "id": 76,
    "category": "past",
    "text": "被忽略的小体贴，补进来了。"
  },
  {
    "id": 77,
    "category": "past",
    "text": "那时脸上的热，字还记得。"
  },
  {
    "id": 78,
    "category": "past",
    "text": "故事的背面，也写着你。"
  },
  {
    "id": 79,
    "category": "past",
    "text": "旧日的欢喜不肯乖乖退场。"
  },
  {
    "id": 80,
    "category": "past",
    "text": "回想起来，连等待都有香气。"
  },
  {
    "id": 81,
    "category": "past",
    "text": "那次擦肩，正在被细细描画。"
  },
  {
    "id": 82,
    "category": "past",
    "text": "一个小瞬间，收藏了好久。"
  },
  {
    "id": 83,
    "category": "past",
    "text": "迟来的坦白停在这一页。"
  },
  {
    "id": 84,
    "category": "past",
    "text": "回忆把声音放得很轻。"
  },
  {
    "id": 85,
    "category": "past",
    "text": "原来那天就已经有点偏心。"
  },
  {
    "id": 86,
    "category": "past",
    "text": "走过的路，悄悄多了路标。"
  },
  {
    "id": 87,
    "category": "past",
    "text": "从前没取名的感觉，有了名字。"
  },
  {
    "id": 88,
    "category": "past",
    "text": "一件傻事，又惹出了笑。"
  },
  {
    "id": 89,
    "category": "past",
    "text": "那时的晚霞，还欠几句夸奖。"
  },
  {
    "id": 90,
    "category": "past",
    "text": "把遗落的心情接回故事里。"
  },
  {
    "id": 91,
    "category": "past",
    "text": "旧章节里发现了一颗糖。"
  },
  {
    "id": 92,
    "category": "past",
    "text": "那天的沉默，也想被听见。"
  },
  {
    "id": 93,
    "category": "past",
    "text": "再描一遍记忆中的轮廓。"
  },
  {
    "id": 94,
    "category": "past",
    "text": "往事的信封，今天才拆开。"
  },
  {
    "id": 95,
    "category": "past",
    "text": "那份悸动没有过保质期。"
  },
  {
    "id": 96,
    "category": "past",
    "text": "回忆里的人，又靠近了一点。"
  },
  {
    "id": 97,
    "category": "past",
    "text": "一段路程装下好多不舍。"
  },
  {
    "id": 98,
    "category": "past",
    "text": "当年的暗号，还认得吗？"
  },
  {
    "id": 99,
    "category": "past",
    "text": "补上一笔，才像完整的那天。"
  },
  {
    "id": 100,
    "category": "past",
    "text": "你出现过的旧时光，真耐读。"
  },
  {
    "id": 101,
    "category": "past",
    "text": "那次迟疑，或许也是心动。"
  },
  {
    "id": 102,
    "category": "past",
    "text": "回忆正在认真整理衣角。"
  },
  {
    "id": 103,
    "category": "past",
    "text": "一场老电影，有了新影评。"
  },
  {
    "id": 104,
    "category": "past",
    "text": "从前的好，正在被逐件数起。"
  },
  {
    "id": 105,
    "category": "past",
    "text": "那次告别，心里其实没走远。"
  },
  {
    "id": 106,
    "category": "past",
    "text": "写到旧事，语气不自觉变软。"
  },
  {
    "id": 107,
    "category": "past",
    "text": "当初的一点勇敢，被珍藏着。"
  },
  {
    "id": 108,
    "category": "past",
    "text": "记忆的折痕，也舍不得抚平。"
  },
  {
    "id": 109,
    "category": "past",
    "text": "那一眼的分量，现在才称清。"
  },
  {
    "id": 110,
    "category": "past",
    "text": "过去的普通日子有了金边。"
  },
  {
    "id": 111,
    "category": "past",
    "text": "一句旧话，重新听出了甜。"
  },
  {
    "id": 112,
    "category": "past",
    "text": "曾经的拘谨，成了珍贵花絮。"
  },
  {
    "id": 113,
    "category": "past",
    "text": "那段路的尽头，留着余韵。"
  },
  {
    "id": 114,
    "category": "past",
    "text": "小心翻页，里面住着心跳。"
  },
  {
    "id": 115,
    "category": "past",
    "text": "那天被风吹乱的心，正在归档。"
  },
  {
    "id": 116,
    "category": "past",
    "text": "重新命名那次不经意的靠近。"
  },
  {
    "id": 117,
    "category": "past",
    "text": "回忆把那份认真保管得很好。"
  },
  {
    "id": 118,
    "category": "past",
    "text": "旧时光里的小失误也很可爱。"
  },
  {
    "id": 119,
    "category": "past",
    "text": "当时的雀跃，隔着字都看得见。"
  },
  {
    "id": 120,
    "category": "past",
    "text": "一声熟悉的称呼，又暖了一次。"
  },
  {
    "id": 121,
    "category": "past",
    "text": "那场日落，还能看第二遍。"
  },
  {
    "id": 122,
    "category": "past",
    "text": "藏在旧事里的喜欢探出头了。"
  },
  {
    "id": 123,
    "category": "past",
    "text": "某个瞬间，终于舍得详细写。"
  },
  {
    "id": 124,
    "category": "past",
    "text": "回头补一句：那天真好。"
  },
  {
    "id": 125,
    "category": "past",
    "text": "那份没来由的开心，有迹可循。"
  },
  {
    "id": 126,
    "category": "past",
    "text": "记忆的小抽屉被轻轻拉开。"
  },
  {
    "id": 127,
    "category": "past",
    "text": "从前的惊喜，今天仍有回声。"
  },
  {
    "id": 128,
    "category": "past",
    "text": "一段旧路，又走出了温柔。"
  },
  {
    "id": 129,
    "category": "past",
    "text": "那天借来的外套，还带着故事。"
  },
  {
    "id": 130,
    "category": "past",
    "text": "把旧日的委屈也轻轻安放。"
  },
  {
    "id": 131,
    "category": "past",
    "text": "回忆不催人，只等一句补充。"
  },
  {
    "id": 132,
    "category": "past",
    "text": "那时递来的手，值得另起一行。"
  },
  {
    "id": 133,
    "category": "past",
    "text": "一句当初的谢谢，正在加温。"
  },
  {
    "id": 134,
    "category": "past",
    "text": "旧日的太阳，照进了这一页。"
  },
  {
    "id": 135,
    "category": "past",
    "text": "那次装作随意，写着写着露馅。"
  },
  {
    "id": 136,
    "category": "past",
    "text": "终于给那场心动配上字幕。"
  },
  {
    "id": 137,
    "category": "past",
    "text": "走过很多天，还是想记这一天。"
  },
  {
    "id": 138,
    "category": "past",
    "text": "回忆里有个不肯散场的黄昏。"
  },
  {
    "id": 139,
    "category": "past",
    "text": "那句没接住的话，重新接住。"
  },
  {
    "id": 140,
    "category": "past",
    "text": "从前的你们，多了一位旁白。"
  },
  {
    "id": 141,
    "category": "past",
    "text": "旧故事有了另一束光。"
  },
  {
    "id": 142,
    "category": "past",
    "text": "那次小小的迁就，没被漏掉。"
  },
  {
    "id": 143,
    "category": "past",
    "text": "一片老风景，被写出了温度。"
  },
  {
    "id": 144,
    "category": "past",
    "text": "当年的紧张，藏不住了。"
  },
  {
    "id": 145,
    "category": "past",
    "text": "回忆正在把甜味慢慢熬出来。"
  },
  {
    "id": 146,
    "category": "past",
    "text": "给那段匆忙补一点慢镜头。"
  },
  {
    "id": 147,
    "category": "past",
    "text": "原来那天的心情这么丰富。"
  },
  {
    "id": 148,
    "category": "past",
    "text": "再看看那时，是怎样走近的。"
  },
  {
    "id": 149,
    "category": "past",
    "text": "旧照片没声音，文字替它说。"
  },
  {
    "id": 150,
    "category": "past",
    "text": "那点小别扭，也有柔软的底色。"
  },
  {
    "id": 151,
    "category": "past",
    "text": "晚到的注释，刚好写进心里。"
  },
  {
    "id": 152,
    "category": "past",
    "text": "故事从那天，悄悄拐了个弯。"
  },
  {
    "id": 153,
    "category": "past",
    "text": "把记忆里的风声调小些。"
  },
  {
    "id": 154,
    "category": "past",
    "text": "那次同行，不只有目的地。"
  },
  {
    "id": 155,
    "category": "past",
    "text": "回忆正在补拍一个特写。"
  },
  {
    "id": 156,
    "category": "past",
    "text": "一段心照不宣，终于落了笔。"
  },
  {
    "id": 157,
    "category": "past",
    "text": "当时没好意思夸的，现在夸。"
  },
  {
    "id": 158,
    "category": "past",
    "text": "那天的亮点，可能一直是你。"
  },
  {
    "id": 159,
    "category": "past",
    "text": "旧时光也值得一次认真回应。"
  },
  {
    "id": 160,
    "category": "past",
    "text": "回望的目光，比日期更长情。"
  },
  {
    "id": 161,
    "category": "past",
    "text": "从前的星星落进了句子里。"
  },
  {
    "id": 162,
    "category": "past",
    "text": "那次约定，如今读来仍柔软。"
  },
  {
    "id": 163,
    "category": "past",
    "text": "遗漏的半个故事，正在补齐。"
  },
  {
    "id": 164,
    "category": "past",
    "text": "回忆的小火苗，又跳了一下。"
  },
  {
