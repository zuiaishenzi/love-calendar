{
  "name": "our-days-desktop",
  "version": "1.8.0",
  "private": true,
  "description": "朝夕 Windows 客户端",
  "author": "Our Days",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "xyz.ourdays.desktop",
    "productName": "朝夕",
    "directories": {
      "output": "../../../love-app"
    },
    "files": [
      "main.cjs",
      "config.json",
      "offline.html",
      "icon.png",
      "updater.cjs",
      "client-build.json"
    ],
    "artifactName": "OurDays-${version}-Windows-build10804-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "朝夕"
    },
    "buildVersion": "1.8.0.10804"
  }
}
