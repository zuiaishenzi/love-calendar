<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_frame" android:padding="0dp" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:src="@drawable/widget_background" />
    <LinearLayout android:id="@+id/widget_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_overlay" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:clickable="true">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="?android:attr/textColorPrimary" android:maxLines="2" />
            <TextView android:id="@+id/widget_body" android:breakStrategy="simple" android:hyphenationFrequency="none" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" android:paddingTop="10dp" android:paddingBottom="2dp" />
            <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="?android:attr/textColorPrimary" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_read" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="✓ 已读" android:textColor="?android:attr/textColorPrimary" android:textSize="11sp" android:contentDescription="标记当前消息已读" />
            <FrameLayout android:id="@+id/widget_refresh_button" android:layout_width="32dp" android:layout_height="match_parent" android:contentDescription="立即刷新桌面卡片">
                <TextView android:id="@+id/widget_refresh" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="21sp" android:textColor="?android:attr/textColorPrimary" />
                <ProgressBar android:id="@+id/widget_refresh_progress" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateTint="#A16986" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
